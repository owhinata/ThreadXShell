# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Local reference material (never read by cmake/scripts; see CLAUDE.md)
_ref/

# Build output.  One build directory per board under build/ (build/wio-lite-ai,
# build/f746g-disco, build/grove-vision-ai-v2, ...), plus the variant trees the
# feature toggles want kept side by side -- build/wio-lite-ai-tflm for
# CONFIG_NN_BACKEND=tflm, which additionally holds the fetched tflite-micro +
# CMSIS-NN source tree and is several hundred MB.  The build-*/ pattern also
# catches strays from the old flat naming.  (The Himax SDK checkout is ignored
# separately, by boards/grove-vision-ai-v2/.gitignore.)
/build/
/build-*/

# Downloaded ARM GNU toolchain (fetched by cmake/arm-none-eabi-toolchain.cmake)
/tools/

# Python
__pycache__/

# On-device NN artifacts for boards/f746g-disco (CONFIG_NN_BACKEND=stedgeai /
# stedgeai_reloc).  The X-CUBE-AI generator output and the relocatable network
# blob are ST-SLA licensed and the models themselves are model-zoo licensed, so
# none of them may be committed to a public repository.
/boards/f746g-disco/port/nn/generated/
/boards/f746g-disco/port/nn/reloc-out/
*.tflite
*.onnx
*_rel.bin

# Virtualenvs created at configure time -- .venv by the boards' tflite-micro.cmake
# (CONFIG_NN_BACKEND=tflm) to hold numpy/Pillow for the tflite-micro tree
# generation, and the -mlperf variants for the host side of a benchmark run.  All
# reproducible from a requirements.txt, so none of them belong in git.
/.venv*/
