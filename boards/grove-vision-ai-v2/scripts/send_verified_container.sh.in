#!/bin/sh
#
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 ThreadX Shell Project
#
# Assemble a model + plugin container and send it to `blob write`, but only
# after the whole chain has passed (issue #101 = #78 Step 1a).  Generated by
# CMake from scripts/send_verified_container.sh.in -- edit that, not this.
#
# This is send_verified_model.sh with a container in the middle, and it keeps
# every guarantee that one has, for the same reasons.  What is new is the order.
#
# [!] ASSEMBLE FIRST, THEN VERIFY WHAT WAS ASSEMBLED.  The obvious shape --
# check the parts, staple them together, send -- is NOT equivalent.  The old
# script's strength is that the file it verified and the file it sent are one
# file; verifying components and then building leaves the packer free to read
# the inputs again, and nothing downstream would notice.  So:
#
#     stage -> pack once -> re-parse the container -> extract the model and the
#     plugin image FROM IT -> run the model gate on those extracted bytes ->
#     run the DEVICE'S OWN validator over the whole container -> send that
#     unmodified file.
#
# [!] THE DEVICE'S VALIDATOR RUNS HERE TOO.  verify_container links
# svc/plugin_load.c -- the same code the firmware runs -- so a container cannot
# pack cleanly and be refused on the board.  Issue #93 is why: its host gate ran
# the flatbuffer verifier with default limits while the firmware used its own,
# and a model passed here and failed there, after the erase.
#
# [!] --slot IS MANDATORY, AND SO IS THE ONE YOU TYPE ON THE BOARD.  The host
# cannot discover the target: `blob write` chooses a slot on the DEVICE and
# ERASES THE WHOLE SLOT before the YMODEM size header arrives, so an oversized
# container is discovered after ~40 s of erase with the old contents already
# gone.  Refusing here is the only place it can be refused before damage.  The
# two slot numbers must match; nothing can check that for you.
#
# [!] EVERYTHING DIAGNOSTIC GOES TO stderr.  picocom connects this command's
# stdout to the serial line, so one printf on the wrong stream is bytes in the
# middle of a YMODEM handshake.
#
# Usage, from picocom:
#
#   picocom -b 921600 /dev/ttyACM0 \
#       --send-cmd "<build>/send_verified_container.sh --profile det --slot 9"
#
# then on the board `blob write det 9`, and C-a C-s in picocom.

set -e

VERIFIER="@GROVE_SEND_VERIFIER@"
CONTAINER_VERIFIER="@GROVE_CONTAINER_VERIFIER@"
PACKER="@GROVE_PACKER@"
LAYOUT="@GROVE_ABI_LAYOUT_JSON@"
SLOTS="@GROVE_SLOT_TABLE_JSON@"
PLUGIN_ELF="@GROVE_PLUGIN_ELF@"
PLUGIN_STACKS="@GROVE_PLUGIN_STACKS@"
PLUGIN_TARGET_ID="@GROVE_PLUGIN_TARGET_ID@"
PLUGIN_BASE="@GROVE_PLUGIN_BASE@"
PLUGIN_MAX="@GROVE_PLUGIN_MAX@"
NM="@CMAKE_NM@"
OBJCOPY="@CMAKE_OBJCOPY@"
PYTHON="@Python3_EXECUTABLE@"
SB="@GROVE_SEND_SB@"

die() {
    printf '%s: %s\n' "send_verified_container" "$1" >&2
    exit 1
}

profile=""
slot=""
while [ $# -gt 0 ]; do
    case "$1" in
    --profile) [ $# -ge 2 ] || die "--profile needs cls or det"; profile="$2"; shift 2 ;;
    --profile=*) profile="${1#--profile=}"; shift ;;
    --slot) [ $# -ge 2 ] || die "--slot needs a number"; slot="$2"; shift 2 ;;
    --slot=*) slot="${1#--slot=}"; shift ;;
    --) shift; break ;;
    -*) die "unknown option '$1'" ;;
    *) break ;;
    esac
done

case "$profile" in
cls)  verify_args="" ;;
det)  verify_args="--blazeface" ;;
"")   die "no --profile; say cls or det (it decides which checks run)" ;;
*)    die "unknown profile '$profile'; want cls or det" ;;
esac

case "$slot" in
"")            die "no --slot; the device erases the whole slot before it learns the size, so the fit has to be checked here" ;;
*[!0-9]*)      die "--slot wants a number, got '$slot'" ;;
esac

[ $# -eq 1 ] || die "want exactly one model file, got $#"
src="$1"
[ -f "$src" ] || die "no such file: $src"

# [!] FAIL CLOSED, ON EVERY LINK OF THE CHAIN.  A missing tool means nothing is
# sent.  Skipping a check and transferring anyway would make the gate advisory,
# and an advisory gate over an operation that erases a slot first is the thing
# this wrapper exists not to be.
[ -n "$VERIFIER" ] || \
    die "no host C++ compiler was found when this build was configured, so the model gate does not exist; refusing to send"
[ -x "$VERIFIER" ] || \
    die "model verifier not built: $VERIFIER (cmake --build <build> --target model-tools)"
[ -x "$CONTAINER_VERIFIER" ] || \
    die "container verifier not built: $CONTAINER_VERIFIER"
[ -f "$PLUGIN_ELF" ] || \
    die "no plugin image: $PLUGIN_ELF (cmake --build <build> --target plugin)"
[ -f "$PLUGIN_STACKS" ] || \
    die "no stack bounds from the plugin gate: $PLUGIN_STACKS -- the manifest may not declare a stack nobody derived"
[ -f "$LAYOUT" ] || die "no ABI layout: $LAYOUT"
[ -f "$SLOTS" ] || die "no slot table: $SLOTS"

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT INT TERM
staged_model="$stage/model.tflite"
container="$stage/asset.nnc"
cp -- "$src" "$staged_model"

# The stack numbers the gate derived, turned into --stack arguments.  The packer
# refuses to declare a stack for a slot nobody measured.
stack_args=$("$PYTHON" -c '
import json, sys
names = {"pl_entry": "entry", "pl_shapes_ok": "shapes_ok", "pl_decode": "decode",
         "pl_draw": "draw", "pl_report": "report",
         "pl_param_set": "param_set", "pl_param_get": "param_get"}
b = json.load(open(sys.argv[1]))
print(" ".join("--stack %s=%d" % (names[k], v) for k, v in b.items() if k in names))
' "$PLUGIN_STACKS")

printf 'send_verified_container: packing %s (profile %s) for slot %s\n' \
    "$src" "$profile" "$slot" >&2

# shellcheck disable=SC2086
"$PYTHON" "$PACKER" --layout "$LAYOUT" --elf "$PLUGIN_ELF" \
    --model "$staged_model" --name "$profile" \
    --build-id "@GROVE_PLUGIN_BUILD_ID@" --out "$container" \
    --nm "$NM" --objcopy "$OBJCOPY" --target-id "$PLUGIN_TARGET_ID" \
    $stack_args >&2 || die "packing failed; nothing was sent"

# From here on, only the assembled container is read.
#
# The model gate runs on the bytes EXTRACTED FROM THE CONTAINER, not on the
# staged copy: what matters is that what will be parsed on the board is a model
# this firmware can run.
extracted="$stage/extracted.tflite"
"$PYTHON" -c '
import json, struct, sys
L = json.load(open(sys.argv[1]))
blob = open(sys.argv[2], "rb").read()
hm = L["hdr"]
n = struct.unpack_from("<I", blob, hm["section_count"])[0]
for i in range(n):
    at = hm["sections"] + i * L["section_size"]
    t = struct.unpack_from("<I", blob, at + L["section"]["type"])[0]
    o = struct.unpack_from("<I", blob, at + L["section"]["offset"])[0]
    ln = struct.unpack_from("<I", blob, at + L["section"]["length"])[0]
    if t == L["section_type"]["model"]:
        open(sys.argv[3], "wb").write(blob[o:o + ln])
        sys.exit(0)
sys.exit("no model section in the container")
' "$LAYOUT" "$container" "$extracted" >&2 || die "could not extract the model"

# shellcheck disable=SC2086
"$VERIFIER" "$extracted" $verify_args >&2 || \
    die "the model gate rejected the model inside the container; nothing was sent"

# And the device's own validator over the whole thing.
"$CONTAINER_VERIFIER" "$container" \
    --target "$PLUGIN_TARGET_ID" --link "$PLUGIN_BASE" --capacity "$PLUGIN_MAX" \
    --stack 0=8192 --stack 1=8192 --stack 2=8192 --stack 3=1024 \
    --stack 4=4096 --stack 5=4096 --stack 6=4096 >&2 || \
    die "the device's validator rejected the container; nothing was sent"

# Will it fit the slot the operator named?
size=$(wc -c < "$container")
cap=$("$PYTHON" -c '
import json, sys
t = json.load(open(sys.argv[1]))
want = int(sys.argv[2])
for s in t["slots"]:
    if s["index"] == want:
        print(s["payload_max"]); break
else:
    sys.exit("slot %d is not in the map" % want)
' "$SLOTS" "$slot") || die "unknown slot $slot"
[ "$size" -le "$cap" ] || \
    die "the container is $size B and slot $slot holds $cap B; the device would erase it before finding out"

printf 'send_verified_container: all gates passed, sending %s B to slot %s\n' \
    "$size" "$slot" >&2

# The file that was checked is the file that goes.  Not `exec`: that would
# replace this shell and with it the EXIT trap, leaving a copy of every
# container ever sent in a temp directory nobody deletes.
rc=0
$SB -k "$container" || rc=$?
exit $rc
