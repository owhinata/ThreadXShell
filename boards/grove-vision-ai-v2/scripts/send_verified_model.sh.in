#!/bin/sh
#
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 ThreadX Shell Project
#
# Send a Vela model to `blob write`, but only after the host gate has passed it
# (issue #93).  Generated by CMake from scripts/send_verified_model.sh.in --
# edit that, not this.
#
# WHY THERE IS A WRAPPER AT ALL.  Until #93 the models were flashed by
# `--target flash-model-cls|det`, and the verifier ran INSIDE that target: there
# was no way to write a model without it.  `blob write` has no such chain -- it
# takes whatever arrives on the wire -- and the device-side checks that #93 adds
# do not replace this one.  They cannot: the board checks that a flatbuffer
# holds together within its length, while verify_vela_model checks that it is a
# model THIS FIRMWARE CAN RUN (one subgraph, every operator on Ethos-U, int8
# I/O, an offline plan, no unreachable tensors, an arena that fits, and for the
# detector the shapes the decoder looks for).  And the board's checks happen
# AFTER the write: a bad model has already cost ~40 s of erase and transfer, and
# a flash cycle of a part whose endurance is not documented (#89).
#
# [!] IT VERIFIES AND SENDS THE SAME FILE, VIA A STAGING COPY.  Verifying one
# path and then sending that path again is a gap -- a build could rewrite it in
# between -- so the copy is made first, checked, and sent.  Nothing reads the
# original after the copy.
#
# [!] THE VERIFIER'S OUTPUT GOES TO stderr.  picocom connects this command's
# stdout to the serial line, so a single printf on the wrong stream is bytes in
# the middle of a YMODEM handshake.
#
# [!] AND THE PROFILE IS AN ARGUMENT, NEVER A GUESS.  The detector's shape
# checks are det-only and this script does not know what the blob will be
# called; inferring `--blazeface` from a filename would make the strength of the
# gate depend on what somebody named a file.
#
# Usage, from picocom:
#
#   picocom -b 921600 /dev/ttyACM0 \
#       --send-cmd "<build>/send_verified_model.sh --profile det"
#
# then on the board `blob write det <slot>`, and C-a C-s in picocom.

set -e

VERIFIER="@GROVE_SEND_VERIFIER@"
SB="@GROVE_SEND_SB@"

die() {
    printf '%s: %s\n' "send_verified_model" "$1" >&2
    exit 1
}

profile=""
while [ $# -gt 0 ]; do
    case "$1" in
    --profile)
        [ $# -ge 2 ] || die "--profile needs cls or det"
        profile="$2"
        shift 2
        ;;
    --profile=*)
        profile="${1#--profile=}"
        shift
        ;;
    --)
        shift
        break
        ;;
    -*)
        die "unknown option '$1'"
        ;;
    *)
        break
        ;;
    esac
done

case "$profile" in
cls)  verify_args="" ;;
det)  verify_args="--blazeface" ;;
"")   die "no --profile; say cls or det (it decides which checks run)" ;;
*)    die "unknown profile '$profile'; want cls or det" ;;
esac

# One file.  picocom appends whatever was typed at its prompt, and sending two
# where one was verified is exactly the gap the staging copy closes.
[ $# -eq 1 ] || die "want exactly one file to send, got $#"
src="$1"
[ -f "$src" ] || die "no such file: $src"

# [!] FAIL CLOSED.  The verifier is built by `--target model-tools`, which only
# exists when a host C++ compiler was found at configure time.  Missing, this
# script sends NOTHING -- skipping the check and transferring anyway would make
# the gate advisory, and an advisory gate over a destructive operation is the
# thing #93 set out not to build.
[ -n "$VERIFIER" ] || \
    die "no host C++ compiler was found when this build was configured, so the model gate does not exist; refusing to send"
[ -x "$VERIFIER" ] || \
    die "verifier not built: $VERIFIER (cmake --build <build> --target model-tools)"

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT INT TERM
staged="$stage/model.tflite"
cp -- "$src" "$staged"

printf 'send_verified_model: %s (profile %s)\n' "$src" "$profile" >&2
# shellcheck disable=SC2086
"$VERIFIER" "$staged" $verify_args >&2 || \
    die "the model gate rejected it; nothing was sent"

printf 'send_verified_model: gate passed, sending %s B\n' \
    "$(wc -c < "$staged")" >&2

# The file that was checked is the file that goes.
#
# [!] NOT `exec`.  The sender inherits this shell's stdin and stdout either way,
# so it owns the serial line just as directly -- but exec replaces the shell,
# and with it the EXIT trap, which would leave a copy of every model ever sent
# in a temp directory nobody deletes.  Waiting costs one idle process and makes
# the cleanup happen.
rc=0
$SB -k "$staged" || rc=$?
exit $rc
